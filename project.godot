; Deep Tycoon — Godot 4 project
; Idle miner tycoon. Cible principale : Google Play (Android). iOS secondaire.
; Doc : docs/PRD.md, docs/specs/*.md, docs/tasks/roadmap.md

config_version=5

[application]

config/name="Deep Tycoon"
config/description="Idle miner tycoon — extraire, transporter, vendre, automatiser, prestige."
config/version="0.1.0"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://game/systems/save_manager.gd"
Ads="*res://game/systems/ads_manager.gd"
Haptics="*res://game/systems/haptics.gd"
Audio="*res://game/systems/audio_manager.gd"
Game="*res://game/systems/game_controller.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
